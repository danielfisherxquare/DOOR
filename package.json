{
  "name": "arcspro-event-manage-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:secrets": "node scripts/check-tracked-secrets.mjs",
    "lint": "eslint src tests packages",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test:branding": "node --test tests/branding/branding.test.mjs",
    "test:contracts": "node --test packages/contracts/tests/contracts.test.js",
    "test:map": "node --test tests/map/map-utils.test.mjs tests/map/map-e2e.test.mjs",
    "test:map:unit": "node --test tests/map/map-utils.test.mjs tests/map/mapArchitecture.test.mjs",
    "test:map:e2e": "node --test tests/map/map-e2e.test.mjs",
    "test:terrain-model": "node --test tests/terrain-model/terrainModel.test.mjs tests/terrain-model/terrainModelArchitecture.test.mjs tests/terrain-model/terrainModelPageArchitecture.test.mjs",
    "test:surfaces": "node --test tests/surfaceContext.test.js tests/workspaceSession.test.js tests/moduleAccess.test.js tests/surfaceBoundaries.test.js",
    "test:3d-studio": "node --test tests/3d-studio/editorDocument.test.js tests/3d-studio/focusZoneStudioScene.test.js tests/3d-studio/studioExport.test.js tests/3d-studio/studioModelArchitecture.test.mjs tests/3d-studio/studioModelParity.test.mjs",
    "test:reimbursement": "node tests/reimbursement/reimbursement-e2e.test.js",
    "test:reimbursement:headless": "cross-env HEADLESS=true node tests/reimbursement/reimbursement-e2e.test.js",
    "test": "node --test packages/contracts/tests/contracts.test.js tests/api/*.test.mjs tests/auth/*.test.mjs tests/routes/*.test.mjs tests/tooling/*.test.mjs tests/security/*.test.mjs tests/surfaceContext.test.js tests/workspaceSession.test.js tests/moduleAccess.test.js tests/surfaceBoundaries.test.js tests/3d-studio/editorDocument.test.js tests/3d-studio/focusZoneStudioScene.test.js tests/3d-studio/studioExport.test.js tests/3d-studio/studioModelArchitecture.test.mjs tests/3d-studio/studioModelParity.test.mjs tests/terrain-model/terrainModel.test.mjs tests/terrain-model/terrainModelArchitecture.test.mjs tests/terrain-model/terrainModelPageArchitecture.test.mjs tests/map/map-utils.test.mjs tests/map/mapArchitecture.test.mjs tests/branding/branding.test.mjs"
  },
  "dependencies": {
    "@arcspro/contracts": "0.1.0",
    "@arcspro/studio-model": "0.1.0",
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@pascal-app/core": "^0.6.0",
    "@pascal-app/viewer": "^0.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@turf/turf": "^7.3.4",
    "@types/leaflet": "^1.9.21",
    "@uiw/react-amap": "^7.1.13",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "axios": "^1.6.7",
    "cesium": "^1.139.1",
    "chart.js": "^4.5.1",
    "docxtemplater": "^3.68.3",
    "earcut": "^2.2.4",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "gb2260": "^0.6.0",
    "gcoord": "^1.0.7",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "pinyin-pro": "^3.28.0",
    "pizzip": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.22.0",
    "react-toastify": "^11.0.5",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.8",
    "vite-plugin-cesium": "^1.2.23",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.7.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.8",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "lodash": "^4.17.21"
  }
}
