{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "settings": {
    "react": { "version": "19" }
  },
  "plugins": ["react"],
  "globals": {
    "FileSystemDirectoryHandle": "readonly",
    "showDirectoryPicker": "readonly"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "server/",
    "public/",
    "*.config.js"
  ],
  "rules": {
    "react/jsx-uses-react": "off",
    "react/jsx-uses-vars": "error",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": ["warn", "smart"]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "rules": {
        "no-undef": "off"
      }
    }
  ]
}
