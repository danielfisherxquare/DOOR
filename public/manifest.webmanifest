{
  "name": "中奥致远赛事管理系统",
  "short_name": "中奥致远",
  "description": "中奥致远赛事管理系统应用层工作台，支持赛事、报销、仓储、证件和空间工具。",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#FCF9F8",
  "theme_color": "#D4A017",
  "categories": ["business", "productivity"],
  "lang": "zh-CN",
  "icons": [
    {
      "src": "/icons/arcspro-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/arcspro-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/arcspro-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "我的工作台",
      "short_name": "工作台",
      "url": "/app",
      "icons": [{ "src": "/icons/arcspro-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "我的报销",
      "short_name": "报销",
      "url": "/app/reimbursements",
      "icons": [{ "src": "/icons/arcspro-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
