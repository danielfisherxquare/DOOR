POSTGRES_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret
ASSESSMENT_FIELD_ENCRYPTION_KEY=your_assessment_field_encryption_key
ASSESSMENT_SESSION_JWT_SECRET=your_assessment_session_jwt_secret
ASSESSMENT_HASH_PEPPER=your_assessment_hash_pepper
PII_ACTIVE_KEY_VERSION=v1
PII_ENCRYPTION_KEY_V1=your_64_character_hex_pii_encryption_key_v1
PII_HMAC_KEY_V1=your_64_character_hex_pii_hmac_key_v1
# Populate V2 only during an approved key rotation.
PII_ENCRYPTION_KEY_V2=
PII_HMAC_KEY_V2=
NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://door.example.com
FRONTEND_URL=https://door.example.com
REDIS_URL=redis://redis:6379

# Authorization (production requires an immutable OpenFGA model id)
AUTHZ_PROVIDER=openfga
FGA_API_URL=
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_API_TOKEN=

# Comma-separated allowed origins in production
# Include the port when the frontend uses a non-default port.
CORS_ORIGIN=https://door.example.com,http://203.0.113.10

# Nginx template values; certificate files live under /etc/nginx/ssl in the container.
NGINX_SERVER_NAME=door.example.com
NGINX_SSL_CERT=door.example.com.pem
NGINX_SSL_KEY=door.example.com.key

# PII encryption key ring. Generate independent random values for each key.
PII_ACTIVE_KEY_VERSION=v1
PII_ENCRYPTION_KEY_V1=
PII_HMAC_KEY_V1=

# Disable public registration in production
DISABLE_REGISTRATION=true

# Local backup/restore center
HOST_BACKUP_DIR=/var/backups/door
BACKUP_DIR=/backups
BACKUP_RETENTION_COUNT=10
RESTORE_UPLOAD_DIR=/backups/uploads

# Super admin seed (run: docker compose exec -e SUPER_ADMIN_PASSWORD=... app node scripts/seed-super-admin.js)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=admin@platform.local
SUPER_ADMIN_PASSWORD=

# DashScope LLM API（马拉松报告生成器）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# Reimbursement OCR (may use a separate provider credential)
REIMBURSEMENT_OCR_PROVIDER=qwen
REIMBURSEMENT_OCR_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
REIMBURSEMENT_OCR_API_KEY=your_reimbursement_ocr_api_key
REIMBURSEMENT_OCR_MODEL_NAME=qwen3.5-plus
