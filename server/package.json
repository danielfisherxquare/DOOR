{
  "name": "arcspro-server",
  "version": "0.1.0",
  "description": "ArcSpro Workspace 后端服务",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "worker:dev": "node --env-file-if-exists=.env --watch src/worker.js",
    "migrate": "node node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.js",
    "migrate:make": "node node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo-data.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "load:bib-tracking": "node --env-file-if-exists=.env scripts/load-bib-tracking.mjs"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "rate-limit-redis": "^4.2.1",
    "redis": "^4.7.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
