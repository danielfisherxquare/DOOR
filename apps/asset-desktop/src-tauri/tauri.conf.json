{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcSpro Assets",
  "version": "0.1.0",
  "identifier": "work.arcspro.assets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ArcSpro Assets",
      "width": 1280,
      "height": 820,
      "minWidth": 720,
      "minHeight": 560
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://www.arcspro.work:18443 http://127.0.0.1:* http://192.168.1.97:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "ArcSpro team asset library"
  }
}
